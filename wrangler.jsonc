{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "master-blaster-multiplayer",
  "main": "multiplayer/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MATCH_ROOMS", "class_name": "MatchRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "GLOBAL_LOBBY", "class_name": "GlobalLobby" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom", "Matchmaker"]
    },
    { "tag": "v2", "new_sqlite_classes": ["GlobalLobby"] }
  ],
  "routes": [
    { "pattern": "masterblaster.se/api/*", "zone_name": "masterblaster.se" },
    { "pattern": "www.masterblaster.se/api/*", "zone_name": "masterblaster.se" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
