{
  "name": "blaster-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-three.mjs",
    "prebuild": "node scripts/patch-three.mjs",
    "predev": "node scripts/patch-three.mjs",
    "pretest": "node scripts/patch-three.mjs",
    "build": "vite build && node scripts/prepare-sites.mjs && node tests/hosting.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:multiplayer": "wrangler dev --port 8787",
    "deploy:multiplayer": "wrangler deploy",
    "check:multiplayer": "node tests/multiplayerProtocol.test.mjs && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "test:worker": "vitest run",
    "test:multiplayer-live": "node tests/multiplayerLive.mjs",
    "start": "npm run build && node server.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "three": "0.185.1",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  }
}
